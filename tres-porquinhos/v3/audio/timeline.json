      "end": 24.472,
      "duration": 4.32
    },
    {
      "id": "L007",
      "who": "TAMBOR",
      "bg": "fazenda",
      "text": "Eu vou de madeira! Tóc, tóc, tóc! Vai ficar forte e divertida!",
