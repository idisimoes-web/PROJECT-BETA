      "end": 50.891999999999996,
      "duration": 4.272
    },
    {
      "id": "L012",
      "who": "TAMBOR",
      "bg": "madeira",
      "text": "Madeira é mais forte que palha! Olha que porta linda!",
      "pause": 0.2,
      "start": 51.19199999999999,
      "end": 55.57599999999999,
      "duration": 4.584
    },
    {
      "id": "L013",
      "who": "TAMBOR",
      "bg": "madeira",
      "text": "Martelo pra lá, martelo pra cá… e pronto! Ainda dá tempo de brincar!",
      "pause": 0.3,
      "start": 55.775999999999996,
      "end": 61.523999999999994,
      "duration": 6.048
    },
    {
      "id": "L014",
      "who": "TIJOLINHO",
      "bg": "tijolos",
      "text": "Devagar e com carinho… a casinha fica firmizinha.",
